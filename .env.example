DATABASE_URL=file:./.db
# Vercel Storage / Neon sets POSTGRES_URL when the store is linked to the project.
POSTGRES_URL=postgresql://USER:PASSWORD@host/bloodidukki
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/bloodidukki
# Vercel uses SQLite unless this is true, so a missing/dead Atlas cluster cannot block form posts.
USE_MONGO=false
PAYLOAD_SECRET=YOUR_SECRET_HERE
ADMIN_EMAIL=dyfiidukki@gmail.com
ADMIN_PASSWORD=your-admin-password
# Shared form log so Vercel admin and public forms see the same submissions.
# Prefer Vercel KV / Upstash Redis. GitHub is only a fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=
SUBMISSIONS_REPO=your-github-user/bloodidukki-submissions
SUBMISSIONS_TOKEN=github-token-with-contents-access
